# ---------------------------------------------------------------------------
# Cadence / Supabase
#
# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API
#
# `.env.local` is gitignored. On Netlify add the same two variables under
# Site settings -> Environment variables.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / publishable key. Safe to ship to the browser — row level
# security in the database is what actually protects your data.
# NEVER put the service_role key in here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
